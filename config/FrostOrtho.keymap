#include <input/processors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <mouse-gesture.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

// マウスジェスチャー（AMLのYキーを長押ししながらボールを動かす）

&zip_mouse_gesture {
    stroke-size = <50>; // 1ストロークと判定する移動量
    enable-eager-mode;
    suppress-movement; // ジェスチャー中はカーソルを動かさない
    history_back {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LA(LEFT)>; // 戻る
    };

    history_forward {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LA(RIGHT)>; // 進む
    };

    prev_tab {
        pattern = <GESTURE_UP>;
        bindings = <&kp LC(TAB)>; // 次のタブ
    };

    next_tab {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LC(LS(TAB))>; // 前のタブ
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        COMBO_ESC {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        COMBO_CAPSLOCK {
            bindings = <&kp CAPS>;
            key-positions = <20 21>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 7>,
                <&macro_press>,
                <&kp LEFT_WIN &kp LEFT_SHIFT &kp S>,
                <&macro_release>,
                <&kp LEFT_WIN &kp LEFT_SHIFT &kp S>;

            label = "SCREENSHOT";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };

        // Kyemap Editor用

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };

        vol_up_down: vol_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            bindings = <&kp C_VOL_DN>, <&kp C_VOL_UP>;
        };

        // DYA Studio用

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_DN>;
            ccw-binding = <&kp C_VOL_UP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q               &kp W         &kp E         &kp R  &kp T                                     &kp Y          &kp U  &kp I      &mt MINUS O        &kp P
&kp A               &kp S         &kp D         &kp F  &kp G                                     &kp H          &kp J  &kp K      &kp L              &lt 5 ENTER
&mt LEFT_SHIFT Z    &kp X         &kp C         &kp V  &kp B                                     &kp N          &kp M  &kp COMMA  &kp PERIOD         &mt EQUAL INT_RO
&lt 7 LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &mo 1  &kp SPACE  &lt 3 LANG_ZENKAKUHANKAKU      &kp BACKSPACE  &mo 2  &kp RALT   &lt 4 RIGHT_SHIFT  &mt LEFT_BRACKET SLASH
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_1 {
            bindings = <
&kp N7        &kp N8        &kp N9        &kp KP_MULTIPLY  &kp KP_SLASH               &kp KP_NLCK      &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
&kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp KP_PLUS      &kp KP_MINUS               &kp KP_NUMBER_0  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N0           &kp LS(EQUAL)              &kp KP_DOT       &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MULTIPLY
&trans        &trans        &trans        &trans           &trans         &trans      &trans           &trans           &trans           &trans           &kp KP_SLASH
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_2 {
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN    &kp HASH          &kp DOLLAR            &kp PERCENT                &kp PAGE_UP    &kp HOME  &kp UP_ARROW  &kp END    &kp PRINTSCREEN
&kp CARET        &kp AMPERSAND  &kp ASTRK         &kp LEFT_PARENTHESIS  &kp INT_RO                 &kp PAGE_DOWN  &kp LEFT  &kp DOWN      &kp RIGHT  &kp SCROLLLOCK
&kp APOSTROPHE   &kp SEMICOLON  &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp BACKSLASH              &trans         &trans    &trans        &trans     &kp PAUSE_BREAK
&trans           &trans         &trans            &trans                &trans         &trans      &trans         &trans    &trans        &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_3 {
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5               &trans  &trans  &trans  &trans  &trans
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10              &trans  &trans  &trans  &trans  &trans
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15              &trans  &trans  &trans  &trans  &trans
&trans   &trans   &trans   &trans   &trans   &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans              &trans          &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans              &studio_unlock  &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans          &trans        &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        // AML: &trans 以外のキーは押しても AML から離脱しない

        MOUSE {
            bindings = <
&trans                &trans  &trans        &trans  &trans              &mouse_gesture_kp 0 Y  &mkp MB1  &mkp MB2  &mkp MB3  &trans
&trans                &trans  &trans        &trans  &trans              &trans                 &trans    &trans    &trans    &trans
&mt LEFT_SHIFT Z      &trans  &trans        &trans  &trans              &trans                 &trans    &trans    &trans    &trans
&mt LEFT_CONTROL TAB  &trans  &kp LEFT_ALT  &trans  &trans  &trans      &trans                 &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_7 {
            bindings = <
&kp LC(Z)           &kp LC(Y)            &kp LC(TAB)             &kp LC(LS(TAB))          &trans              &trans  &trans  &trans  &trans  &trans
&kp RA(LEFT_ARROW)  &kp RA(RIGHT_ARROW)  &kp LC(LG(LEFT_ARROW))  &kp LC(LG(RIGHT_ARROW))  &trans              &trans  &trans  &trans  &trans  &trans
&trans              &screenshot          &kp LC(INS)             &kp LS(INS)              &trans              &trans  &trans  &trans  &trans  &trans
&trans              &trans               &trans                  &trans                   &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
